{
  "name": "unimask",
  "version": "1.0.4",
  "description": "A lightweight utility library for creating mask for input values",
  "keywords": [
    "formatting",
    "input",
    "mask",
    "masking",
    "string",
    "vue-formatting",
    "vue-mask"
  ],
  "homepage": "https://github.com/dschewchenko/unimask#readme",
  "bugs": {
    "url": "https://github.com/dschewchenko/unimask/issues"
  },
  "license": "MIT",
  "author": "dschewchenko",
  "repository": {
    "type": "git",
    "url": "https://github.com/dschewchenko/unimask.git"
  },
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist/*",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "vue": [
        "./dist/vue/index.d.ts"
      ],
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vue": {
      "import": "./dist/vue/index.js",
      "types": "./dist/vue/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "bunx --bun vite build && bunx --bun tsc --emitDeclarationOnly",
    "typecheck": "bun --bun tsrs --checkers 2 --noEmit",
    "test": "bunx --bun vitest",
    "test:coverage": "bunx --bun vitest --coverage",
    "lint": "bunx --bun oxlint",
    "lint:fix": "bunx --bun oxlint --fix",
    "format": "bunx --bun oxfmt --write .",
    "format:check": "bunx --bun oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run test -- --run && bun run build",
    "prepare": "husky",
    "husky:pre-commit": "bun run lint && bun run format:check",
    "prepublishOnly": "bun run build",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jsdom": "^29.1.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "react": "^19.3.1",
    "semantic-release": "^25.0.9",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^4.1.12",
    "vue": "^3.5.44"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ],
    "branches": [
      "main"
    ]
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.14.0"
  },
  "packageManager": "bun@1.4.2"
}
